<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0f766e">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="School GPS">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title>School GPS Locator</title>
<link rel="manifest" href="manifest.json">
<link rel="icon" type="image/png" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<style>
  :root{
    --teal:#0f766e; --teal-dark:#0b5a54; --teal-soft:#e6f4f2;
    --ink:#1b2430; --muted:#5d6b7a; --line:#d9e2e8; --bg:#f2f6f8; --card:#ffffff;
    --ok:#15803d; --okbg:#e7f6ec; --err:#b42318; --errbg:#fdeceb; --info:#1d4ed8; --infobg:#e8effd;
    color-scheme:light;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html{-webkit-text-size-adjust:100%;}
  body{
    margin:0; background:var(--bg); color:var(--ink);
    font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
    font-size:16px; line-height:1.4;
    padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }
  header{background:var(--teal); color:#fff; padding:18px 16px 16px; text-align:center;}
  header h1{margin:0; font-size:1.35rem; letter-spacing:.2px;}
  header p{margin:4px 0 0; font-size:.85rem; opacity:.9;}
  main{max-width:560px; margin:0 auto; padding:14px 16px 40px;}
  .card{background:var(--card); border:1px solid var(--line); border-radius:14px; padding:16px; margin-bottom:14px; box-shadow:0 1px 3px rgba(15,40,60,.06);}
  .card h2{margin:0 0 12px; font-size:1rem; color:var(--teal-dark);}
  label{display:block; font-size:.85rem; font-weight:600; color:var(--muted); margin:0 0 4px;}
  .field{margin-bottom:12px;}
  .field:last-child{margin-bottom:0;}
  input{
    width:100%; font:inherit; font-size:1.05rem; color:var(--ink);
    padding:12px 12px; border:1.5px solid var(--line); border-radius:10px; background:#fff;
    min-height:48px;
  }
  input:focus{outline:none; border-color:var(--teal); box-shadow:0 0 0 3px rgba(15,118,110,.18);}
  .grid{display:grid; grid-template-columns:1fr 1fr; gap:12px;}
  .grid .field{margin-bottom:0;}
  .grid3{display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px;}
  .grid3 .field{margin-bottom:0;}
  .stack{display:grid; gap:12px;}
  button{
    font:inherit; font-weight:700; font-size:1.05rem; border:0; border-radius:12px;
    padding:14px 16px; min-height:52px; width:100%; cursor:pointer;
    background:var(--teal); color:#fff;
  }
  button:active{background:var(--teal-dark);}
  button[disabled]{opacity:.65; cursor:default;}
  button.secondary{background:#fff; color:var(--teal-dark); border:2px solid var(--teal);}
  button.big{min-height:60px; font-size:1.15rem;}
  .status{margin-top:12px; padding:10px 12px; border-radius:10px; font-size:.92rem; display:none;}
  .status.show{display:block;}
  .status.ok{background:var(--okbg); color:var(--ok);}
  .status.err{background:var(--errbg); color:var(--err);}
  .status.info{background:var(--infobg); color:var(--info);}
  .coords{display:none; margin-top:12px; border:1.5px solid var(--teal); background:var(--teal-soft); border-radius:12px; padding:12px;}
  .coords.show{display:block;}
  .coords dl{margin:0; display:grid; grid-template-columns:auto 1fr; gap:6px 12px; font-size:.98rem;}
  .coords dt{color:var(--muted); font-weight:600;}
  .coords dd{margin:0; font-weight:700; word-break:break-word;}
  #preview{display:none; margin-top:14px; text-align:center;}
  #preview.show{display:block;}
  #preview img{width:100%; max-width:420px; height:auto; border:1px solid var(--line); border-radius:10px; background:#fff;}
  #preview p{font-size:.85rem; color:var(--muted); margin:8px 0 0;}
  details{font-size:.9rem; color:var(--muted);}
  details summary{cursor:pointer; font-weight:600; color:var(--teal-dark); padding:4px 0;}
  details ul{margin:8px 0 0; padding-left:20px;}
  .hidden{display:none !important;}
  footer{text-align:center; font-size:.78rem; color:var(--muted); padding:0 16px 24px;}
</style>
</head>
<body>

<header>
  <h1>School GPS Locator</h1>
  <p>Record school details and location &bull; works offline</p>
</header>

<main>

  <section class="card" aria-labelledby="h-details">
    <h2 id="h-details">1. School details</h2>
    <div class="field">
      <label for="school">School name</label>
      <input id="school" type="text" autocomplete="off" maxlength="120" placeholder="e.g. GBPS Tigusar">
    </div>
    <div class="field">
      <label for="semis">SEMIS code</label>
      <input id="semis" type="text" inputmode="numeric" autocomplete="off" maxlength="20" placeholder="e.g. 12345678">
    </div>
    <div class="grid3">
      <div class="field">
        <label for="enrol">Enrolment</label>
        <input id="enrol" type="text" inputmode="numeric" autocomplete="off" maxlength="6" placeholder="0">
      </div>
      <div class="field">
        <label for="rooms">Rooms</label>
        <input id="rooms" type="text" inputmode="numeric" autocomplete="off" maxlength="4" placeholder="0">
      </div>
      <div class="field">
        <label for="teachers">Teachers</label>
        <input id="teachers" type="text" inputmode="numeric" autocomplete="off" maxlength="4" placeholder="0">
      </div>
    </div>
  </section>

  <section class="card" aria-labelledby="h-gps">
    <h2 id="h-gps">2. GPS location</h2>
    <button id="gpsBtn" class="big" type="button">Get GPS Location</button>
    <div id="gpsStatus" class="status" role="status" aria-live="polite"></div>
    <div id="coords" class="coords" aria-live="polite">
      <dl>
        <dt>Latitude</dt><dd id="outLat">-</dd>
        <dt>Longitude</dt><dd id="outLon">-</dd>
        <dt>Accuracy</dt><dd id="outAcc">-</dd>
        <dt>Time</dt><dd id="outTime">-</dd>
      </dl>
    </div>
  </section>

  <section class="card" aria-labelledby="h-save">
    <h2 id="h-save">3. Save as image</h2>
    <div class="stack">
      <button id="saveBtn" type="button">Save Image to Gallery</button>
      <button id="shareBtn" class="secondary hidden" type="button">Share Image</button>
    </div>
    <div id="saveStatus" class="status" role="status" aria-live="polite"></div>
    <div id="preview">
      <img id="previewImg" alt="Generated school location image">
      <p>If the image was not saved automatically, press and hold it and choose &ldquo;Save image&rdquo;.</p>
    </div>
  </section>

  <section class="card">
    <button id="installBtn" class="secondary hidden" type="button">Install App on Home Screen</button>
    <details id="installHelp">
      <summary>How to add to Home Screen</summary>
      <ul>
        <li><strong>Android (Chrome):</strong> tap the &#8942; menu &rarr; <em>Add to Home screen</em> / <em>Install app</em>.</li>
        <li><strong>iPhone (Safari):</strong> tap Share &rarr; <em>Add to Home Screen</em>.</li>
        <li>Open the app once with internet. After that it works offline.</li>
        <li>Allow <em>Location</em> permission when asked, and keep phone GPS turned on.</li>
      </ul>
    </details>
  </section>

</main>

<footer>Your data stays on this phone. Nothing is uploaded.</footer>

<script>
(function () {
  'use strict';

  var $ = function (id) { return document.getElementById(id); };
  var FIELDS = ['school', 'semis', 'enrol', 'rooms', 'teachers'];
  var STORE_KEY = 'school-gps-app-v1';

  var gps = null;          // {lat, lon, acc, time}
  var watchId = null;
  var stopTimer = null;
  var lastBlob = null;
  var lastUrl = null;
  var lastName = 'school-location.png';

  /* ---------- small helpers ---------- */
  function safeGet(key) {
    try { return window.localStorage.getItem(key); } catch (e) { return null; }
  }
  function safeSet(key, val) {
    try { window.localStorage.setItem(key, val); } catch (e) { /* storage unavailable */ }
  }

  function setStatus(el, kind, msg) {
    el.className = 'status show ' + kind;
    el.textContent = msg;
  }
  function clearStatus(el) {
    el.className = 'status';
    el.textContent = '';
  }

  function pad2(n) { return (n < 10 ? '0' : '') + n; }
  function formatTime(ms) {
    var d = new Date(ms);
    var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    var h = d.getHours();
    var ap = h >= 12 ? 'PM' : 'AM';
    h = h % 12; if (h === 0) { h = 12; }
    return pad2(d.getDate()) + ' ' + months[d.getMonth()] + ' ' + d.getFullYear() +
           ', ' + pad2(h) + ':' + pad2(d.getMinutes()) + ' ' + ap;
  }
  function fileStamp(ms) {
    var d = new Date(ms);
    return d.getFullYear() + pad2(d.getMonth() + 1) + pad2(d.getDate()) + '-' +
           pad2(d.getHours()) + pad2(d.getMinutes());
  }
  function digitsOnly(s) { return String(s || '').replace(/[^0-9]/g, ''); }

  /* ---------- remember typed details ---------- */
  function loadSaved() {
    var raw = safeGet(STORE_KEY);
    if (!raw) { return; }
    try {
      var data = JSON.parse(raw);
      FIELDS.forEach(function (f) {
        if (data && typeof data[f] === 'string') { $(f).value = data[f]; }
      });
    } catch (e) { /* ignore bad data */ }
  }
  function persist() {
    var data = {};
    FIELDS.forEach(function (f) { data[f] = $(f).value; });
    safeSet(STORE_KEY, JSON.stringify(data));
  }
  FIELDS.forEach(function (f) {
    $(f).addEventListener('input', function () {
      if (f !== 'school') {
        var cleaned = digitsOnly($(f).value);
        if (cleaned !== $(f).value) { $(f).value = cleaned; }
      }
      persist();
    });
  });
  loadSaved();

  /* ---------- GPS ---------- */
  function accuracyLabel(acc) {
    if (acc <= 20) { return 'Good'; }
    if (acc <= 50) { return 'Fair'; }
    return 'Weak';
  }

  function showCoords() {
    if (!gps) { return; }
    $('outLat').textContent = gps.lat.toFixed(6);
    $('outLon').textContent = gps.lon.toFixed(6);
    $('outAcc').textContent = '±' + Math.round(gps.acc) + ' m (' + accuracyLabel(gps.acc) + ')';
    $('outTime').textContent = formatTime(gps.time);
    $('coords').className = 'coords show';
  }

  function stopWatching() {
    if (watchId !== null) {
      try { navigator.geolocation.clearWatch(watchId); } catch (e) { /* ignore */ }
      watchId = null;
    }
    if (stopTimer !== null) {
      clearTimeout(stopTimer);
      stopTimer = null;
    }
  }

  function getLocation() {
    var btn = $('gpsBtn');
    var box = $('gpsStatus');

    if (!('geolocation' in navigator)) {
      setStatus(box, 'err', 'GPS is not supported in this browser.');
      return;
    }
    if (window.isSecureContext === false) {
      setStatus(box, 'err', 'Location needs a secure (https) page. Open the app from its https link.');
      return;
    }

    stopWatching();
    var best = null;
    var done = false;

    btn.disabled = true;
    btn.textContent = 'Getting location…';
    setStatus(box, 'info', 'Searching for GPS signal… stay outside or near a window for best accuracy.');

    function finish(failMsg) {
      if (done) { return; }
      done = true;
      stopWatching();
      btn.disabled = false;
      btn.textContent = best ? 'Get GPS Location Again' : 'Get GPS Location';
      if (best) {
        gps = best;
        showCoords();
        var msg = 'Location captured. Accuracy ±' + Math.round(best.acc) + ' m.';
        if (best.acc > 50) { msg += ' Accuracy is weak – move outside and tap again for a better reading.'; }
        setStatus(box, best.acc > 50 ? 'info' : 'ok', msg);
      } else {
        setStatus(box, 'err', failMsg || 'Could not get location. Turn on phone GPS, go outside, and try again.');
      }
    }

    try {
      watchId = navigator.geolocation.watchPosition(
        function (pos) {
          var c = pos.coords;
          var cur = { lat: c.latitude, lon: c.longitude, acc: c.accuracy, time: Date.now() };
          if (!best || cur.acc < best.acc) { best = cur; }
          if (best.acc <= 10) { finish(); }
        },
        function (err) {
          if (err && err.code === 1) {
            finish('Location permission was denied. Allow Location for this app in your phone/browser settings, then try again.');
          }
          /* other errors (unavailable / timeout): keep waiting for the timer */
        },
        { enableHighAccuracy: true, maximumAge: 0, timeout: 20000 }
      );
    } catch (e) {
      finish('Could not start GPS on this device.');
      return;
    }

    stopTimer = setTimeout(function () { finish(); }, 15000);
  }

  $('gpsBtn').addEventListener('click', getLocation);

  /* ---------- image drawing ---------- */
  function wrapLines(ctx, text, maxWidth) {
    var words = String(text).split(/\s+/).filter(Boolean);
    var lines = [];
    var line = '';
    words.forEach(function (w) {
      var test = line ? line + ' ' + w : w;
      if (ctx.measureText(test).width <= maxWidth || !line) {
        line = test;
      } else {
        lines.push(line);
        line = w;
      }
    });
    if (line) { lines.push(line); }
    return lines;
  }

  function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  }

  var FONT = 'system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif';

  function drawImage(values) {
    var W = 1080, H = 1500, PAD = 56;
    var canvas = document.createElement('canvas');
    canvas.width = W; canvas.height = H;
    var ctx = canvas.getContext('2d');

    ctx.fillStyle = '#f2f6f8';
    ctx.fillRect(0, 0, W, H);

    /* header band */
    ctx.fillStyle = '#0f766e';
    ctx.fillRect(0, 0, W, 190);
    ctx.fillStyle = '#ffffff';
    ctx.textBaseline = 'alphabetic';
    ctx.textAlign = 'center';
    ctx.font = '700 58px ' + FONT;
    ctx.fillText('School Location Record', W / 2, 98);
    ctx.font = '400 30px ' + FONT;
    ctx.fillStyle = 'rgba(255,255,255,0.9)';
    ctx.fillText('GPS + School Information', W / 2, 146);

    /* school name card */
    var y = 226;
    var maxW = W - PAD * 2 - 60;
    var size = 62, lines;
    do {
      ctx.font = '700 ' + size + 'px ' + FONT;
      lines = wrapLines(ctx, values.school, maxW);
      size -= 4;
    } while (lines.length > 3 && size >= 32);
    size += 4;
    if (lines.length > 3) { lines = lines.slice(0, 3); lines[2] = lines[2].replace(/\s*\S*$/, '') + '…'; }
    var lineH = Math.round(size * 1.22);
    var nameH = 70 + lines.length * lineH + 30;

    ctx.fillStyle = '#ffffff';
    roundRect(ctx, PAD, y, W - PAD * 2, nameH, 22);
    ctx.fill();
    ctx.strokeStyle = '#d9e2e8'; ctx.lineWidth = 2; ctx.stroke();

    ctx.textAlign = 'left';
    ctx.fillStyle = '#5d6b7a';
    ctx.font = '600 28px ' + FONT;
    ctx.fillText('SCHOOL NAME', PAD + 30, y + 52);
    ctx.fillStyle = '#1b2430';
    ctx.font = '700 ' + size + 'px ' + FONT;
    lines.forEach(function (ln, i) {
      ctx.fillText(ln, PAD + 30, y + 70 + size + i * lineH - 8);
    });
    y += nameH + 24;

    /* info rows: SEMIS, enrolment, rooms, teachers */
    var items = [
      ['SEMIS CODE', values.semis || '-'],
      ['ENROLMENT', values.enrol || '-'],
      ['ROOMS', values.rooms || '-'],
      ['TEACHERS', values.teachers || '-']
    ];
    var cw = (W - PAD * 2 - 24) / 2;
    var ch = 130;
    items.forEach(function (it, i) {
      var cx = PAD + (i % 2) * (cw + 24);
      var cy = y + Math.floor(i / 2) * (ch + 22);
      ctx.fillStyle = '#ffffff';
      roundRect(ctx, cx, cy, cw, ch, 20);
      ctx.fill();
      ctx.strokeStyle = '#d9e2e8'; ctx.lineWidth = 2; ctx.stroke();
      ctx.fillStyle = '#5d6b7a';
      ctx.font = '600 26px ' + FONT;
      ctx.fillText(it[0], cx + 28, cy + 46);
      ctx.fillStyle = '#1b2430';
      var vsize = 54;
      ctx.font = '700 ' + vsize + 'px ' + FONT;
      while (ctx.measureText(it[1]).width > cw - 56 && vsize > 26) {
        vsize -= 2;
        ctx.font = '700 ' + vsize + 'px ' + FONT;
      }
      ctx.fillText(it[1], cx + 28, cy + 104);
    });
    y += ch * 2 + 22 + 30;

    /* GPS card */
    var gh = H - y - 120;
    ctx.fillStyle = '#e6f4f2';
    roundRect(ctx, PAD, y, W - PAD * 2, gh, 22);
    ctx.fill();
    ctx.strokeStyle = '#0f766e'; ctx.lineWidth = 3; ctx.stroke();

    ctx.fillStyle = '#0b5a54';
    ctx.font = '700 32px ' + FONT;
    ctx.fillText('GPS LOCATION', PAD + 30, y + 56);

    var rows = [
      ['Latitude', values.lat],
      ['Longitude', values.lon],
      ['Accuracy', values.acc],
      ['Captured', values.time]
    ];
    var ry = y + 120;
    rows.forEach(function (r) {
      ctx.fillStyle = '#5d6b7a';
      ctx.font = '600 28px ' + FONT;
      ctx.fillText(r[0], PAD + 30, ry);
      ctx.fillStyle = '#1b2430';
      ctx.font = '700 40px ' + FONT;
      ctx.fillText(r[1], PAD + 270, ry + 2);
      ry += 70;
    });

    ctx.fillStyle = '#5d6b7a';
    ctx.font = '600 24px ' + FONT;
    ctx.fillText('Map link', PAD + 30, ry + 14);
    ctx.fillStyle = '#1d4ed8';
    ctx.font = '400 26px ' + FONT;
    var linkLines = wrapLines(ctx, values.link, W - PAD * 2 - 60);
    linkLines.slice(0, 2).forEach(function (ln, i) {
      ctx.fillText(ln, PAD + 30, ry + 54 + i * 34);
    });

    /* footer */
    ctx.textAlign = 'center';
    ctx.fillStyle = '#5d6b7a';
    ctx.font = '400 24px ' + FONT;
    ctx.fillText('Generated with School GPS Locator', W / 2, H - 56);

    return canvas;
  }

  /* ---------- save image ---------- */
  function collectValues() {
    var school = $('school').value.replace(/\s+/g, ' ').trim();
    return {
      school: school,
      semis: digitsOnly($('semis').value),
      enrol: digitsOnly($('enrol').value),
      rooms: digitsOnly($('rooms').value),
      teachers: digitsOnly($('teachers').value)
    };
  }

  function sanitizeName(s) {
    var n = String(s).replace(/[^A-Za-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    return (n || 'school').slice(0, 40);
  }

  function triggerDownload(blob, name) {
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = name;
    a.rel = 'noopener';
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();
    setTimeout(function () { document.body.removeChild(a); }, 0);
    return url;
  }

  function saveImage() {
    var box = $('saveStatus');
    var v = collectValues();

    if (!v.school) {
      setStatus(box, 'err', 'Please type the school name first.');
      $('school').focus();
      return;
    }
    if (!gps) {
      setStatus(box, 'err', 'Please tap "Get GPS Location" first.');
      return;
    }

    v.lat = gps.lat.toFixed(6);
    v.lon = gps.lon.toFixed(6);
    v.acc = '±' + Math.round(gps.acc) + ' m';
    v.time = formatTime(gps.time);
    v.link = 'https://maps.google.com/?q=' + v.lat + ',' + v.lon;

    var canvas;
    try {
      canvas = drawImage(v);
    } catch (e) {
      setStatus(box, 'err', 'Could not create the image on this device.');
      return;
    }

    canvas.toBlob(function (blob) {
      if (!blob) {
        setStatus(box, 'err', 'Could not create the image on this device.');
        return;
      }
      lastBlob = blob;
      lastName = sanitizeName(v.school) + '-' + fileStamp(gps.time) + '.png';

      if (lastUrl) { URL.revokeObjectURL(lastUrl); }
      lastUrl = triggerDownload(blob, lastName);
      $('previewImg').src = lastUrl;
      $('preview').className = 'show';

      setStatus(box, 'ok', 'Image saved as ' + lastName + '. Check your Gallery or Downloads folder.');
      refreshShare();
    }, 'image/png');
  }

  $('saveBtn').addEventListener('click', saveImage);

  /* ---------- share (optional) ---------- */
  function refreshShare() {
    var btn = $('shareBtn');
    var ok = false;
    try {
      if (lastBlob && typeof File === 'function' && navigator.share && navigator.canShare) {
        var f = new File([lastBlob], lastName, { type: 'image/png' });
        ok = navigator.canShare({ files: [f] });
      }
    } catch (e) { ok = false; }
    btn.className = ok ? 'secondary' : 'secondary hidden';
  }

  $('shareBtn').addEventListener('click', function () {
    if (!lastBlob) { return; }
    try {
      var f = new File([lastBlob], lastName, { type: 'image/png' });
      navigator.share({ files: [f], title: 'School location' }).catch(function () { /* cancelled */ });
    } catch (e) {
      setStatus($('saveStatus'), 'err', 'Sharing is not available on this device.');
    }
  });

  /* ---------- install ---------- */
  var deferredPrompt = null;
  window.addEventListener('beforeinstallprompt', function (e) {
    e.preventDefault();
    deferredPrompt = e;
    $('installBtn').className = 'secondary';
  });
  window.addEventListener('appinstalled', function () {
    deferredPrompt = null;
    $('installBtn').className = 'secondary hidden';
  });
  $('installBtn').addEventListener('click', function () {
    if (!deferredPrompt) { return; }
    deferredPrompt.prompt();
    deferredPrompt = null;
    $('installBtn').className = 'secondary hidden';
  });

  /* ---------- service worker (offline) ---------- */
  if ('serviceWorker' in navigator && /^https?:$/.test(location.protocol)) {
    window.addEventListener('load', function () {
